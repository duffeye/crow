<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/field_pressed" /><corners android:radius="2dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/field_outline" /><corners android:radius="2dp" /></shape>
    </item>
</selector>
