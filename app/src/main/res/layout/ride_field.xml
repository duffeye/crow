<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/field_touch_background">
    <LinearLayout android:id="@+id/field_header" android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_camera_field" android:importantForAccessibility="no" />
        <TextView android:id="@+id/field_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:textSize="16sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textAllCaps="true" android:includeFontPadding="false"
            android:textColor="@color/field_text" android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <FrameLayout android:id="@+id/field_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:orientation="vertical">
    <TextView android:id="@+id/field_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="24sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:includeFontPadding="false"
        android:textColor="@color/field_text" android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/field_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:textColor="@color/field_secondary" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
